{
  "manifest_version": 3,
  "name": "GeminiWeb MCP Cookie Bridge",
  "version": "1.4.0",
  "description": "Gửi cookie Gemini (đã đăng nhập) về MyGeminiWebMcp chạy trên máy local. Tự đồng bộ ngầm mỗi 20 phút.",
  "permissions": ["cookies", "storage", "tabs", "alarms"],
  "host_permissions": ["https://*.google.com/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "GeminiWeb MCP Cookie Bridge",
    "default_popup": "popup.html"
  }
}
