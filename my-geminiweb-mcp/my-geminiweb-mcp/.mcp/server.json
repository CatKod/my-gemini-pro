{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
  "description": "Gemini Web chat as an MCP server: multi-account pool, automatic failover, and conversation continuity.",
  "name": "io.github.kimvi/my-geminiweb-mcp",
  "version": "0.1.0-beta",
  "packages": [
    {
      "registryType": "nuget",
      "identifier": "MyGeminiWebMcp",
      "version": "0.1.0-beta",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [],
      "environmentVariables": [
        {
          "name": "GEMINIWEB_MCP_HOME",
          "description": "Folder holding accounts.json. Defaults to %LOCALAPPDATA%\\MyGeminiWebMcp.",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/kimvi/my-geminiweb-mcp",
    "source": "github"
  }
}
